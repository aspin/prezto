# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# NVM lazy stubs — replaces prezto nvm module (which loads eagerly despite NVM_LAZY_LOAD)
export NVM_DIR="$HOME/.nvm"
# Agent shell snapshots (Claude Code, Codex) can capture the stubs without
# _nvm_load, so the stubs skip a missing loader and call the real binary via
# `command` (nvm's once loaded, else ~/.local/bin) instead of recursing.
_nvm_load() {
    unfunction nvm node npm npx yarn 2>/dev/null
    [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"
}
nvm()  { _nvm_load; nvm "$@" }
node() { (( $+functions[_nvm_load] )) && _nvm_load; command node "$@" }
npm()  { (( $+functions[_nvm_load] )) && _nvm_load; command npm "$@" }
npx()  { (( $+functions[_nvm_load] )) && _nvm_load; command npx "$@" }
yarn() { (( $+functions[_nvm_load] )) && _nvm_load; command yarn "$@" }
export PATH=$HOME/.local/bin:$PATH

# Lazy-load thefuck — avoids spawning Python on every shell start
fuck() {
    unfunction fuck
    eval "$(thefuck --alias)"
    fuck "$@"
}

export AWS_SDK_LOAD_CONFIG=1

# Prompt: always show the active Python (virtualenv, else pyenv version)
prompt_virtualenv() {
  local venv="${VIRTUAL_ENV:-$(pyenv version-name 2>/dev/null)}"
  [[ -n $venv ]] || return
  prompt_segment cyan $PRIMARY_FG
  print -Pn " py(${venv:t})"
}

# Machine-specific, untracked additions
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
